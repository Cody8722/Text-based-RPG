# 複製成 .env 後可在這裡設定（.env 已被 gitignore）。全部都是選填。
# 已經設定的環境變數優先，不會被這裡蓋掉。

# 說書人（本機 Ollama）：auto=自動偵測、ollama=強制使用、off=關閉
RPG_LLM=auto
RPG_OLLAMA_URL=http://localhost:11434
RPG_MODEL=qwen3.5:9b

# 存檔資料夾（預設 ./saves）
# RPG_SAVE_DIR=./saves

# 1 = 開啟除錯端點（會劇透）
RPG_DEBUG=0

# ---- 以下只給 legacy/game_mvp.py 用 ----
CLOUD_API_KEY=
# CLOUD_API_BASE_URL=https://api.siliconflow.cn/v1
# CLOUD_MODEL=Qwen/Qwen3.5-9B
